cmake_minimum_required(VERSION 3.14)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/MollmCudaArchitectures.cmake")

# Exercise selection policy without a CUDA toolkit, device or external utility.
function(try_run run_result compile_result)
    if(expect_no_probe)
        message(FATAL_ERROR "Cross-compilation must not execute a host GPU probe")
    endif()
    set(${run_result} "${mock_run}" PARENT_SCOPE)
    set(${compile_result} "${mock_compiled}" PARENT_SCOPE)
    set(detected "${mock_devices}" PARENT_SCOPE)
endfunction()

function(try_compile compile_result)
    if(NOT "${ARGN}" MATCHES "CMAKE_CUDA_ARCHITECTURES:STRING=([0-9]+a?)")
        message(FATAL_ERROR "Compiler probe did not receive an architecture")
    endif()
    set(target "${CMAKE_MATCH_1}")
    if(NOT target IN_LIST expected_targets)
        message(FATAL_ERROR "Unexpected compiler probe target: ${target}")
    endif()
    if(reject_target)
        set(${compile_result} FALSE PARENT_SCOPE)
    else()
        set(${compile_result} TRUE PARENT_SCOPE)
    endif()
endfunction()

function(check_selection devices expected)
    set(mock_devices "${devices}")
    set(expected_targets "${expected}")
    mollm_detect_cuda_architectures(actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Expected '${expected}', got '${actual}'")
    endif()
endfunction()

set(mock_run 0)
set(mock_compiled TRUE)
if(MOLLM_TEST_REJECT_TARGET)
    set(reject_target TRUE)
    check_selection("121" "121a")
    message(FATAL_ERROR "Unsupported compiler target was not rejected")
endif()

check_selection("121" "121a")
check_selection("120" "120a")
check_selection("86;121;86;120" "86;121a;120a")
check_selection("89;90;100" "89;90;100")
set(mock_run 1)
check_selection("" "75;80;86")
set(mock_run 0)
set(mock_compiled FALSE)
check_selection("121" "75;80;86")
set(mock_compiled TRUE)
check_selection("invalid probe output" "75;80;86")
set(CMAKE_CROSSCOMPILING TRUE)
set(expect_no_probe TRUE)
check_selection("121" "75;80;86")

execute_process(COMMAND "${CMAKE_COMMAND}" -DMOLLM_TEST_REJECT_TARGET=ON
    -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE rejected OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(rejected EQUAL 0 OR NOT "${output}${error}" MATCHES "Detected GPU requires CUDA target 121a")
    message(FATAL_ERROR "Unsupported toolchain must fail at configure time: ${output}${error}")
endif()
message(STATUS "CUDA architecture selection policy passed")
